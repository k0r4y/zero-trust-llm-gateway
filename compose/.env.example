# Copy this file to compose/.env and fill in your secrets
# Or run ./setup.sh to auto-generate

# LiteLLM master key (used for API auth)
LITELLM_MASTER_KEY=sk-your-token-here

# Open WebUI internal secret
WEBUI_SECRET_KEY=your-random-secret-here

# Open WebUI initial admin (seeded on first run)
WEBUI_INIT_ADMIN_EMAIL=admin@localhost.local
WEBUI_INIT_ADMIN_PASSWORD=change-me-immediately

# Tailscale OAuth credentials (only needed for tofu ACL management)
TAILSCALE_OAUTH_ID=ts-client-id
TAILSCALE_OAUTH_SECRET=ts-client-secret
